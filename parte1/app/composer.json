{
  "name": "oscarlidenbrock/lecturas-api",
  "description": "API de recepción de lecturas de contador",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlsrv": "*",
    "yiisoft/yii2": "~2.0.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "replace": {
    "bower-asset/jquery": ">=1.11.0",
    "bower-asset/inputmask": ">=3.2.0",
    "bower-asset/punycode": ">=1.3.0",
    "bower-asset/yii2-pjax": ">=2.0.0"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  }
}